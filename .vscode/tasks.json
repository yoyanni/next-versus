{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Application",
      "dependsOn": ["Client", "Server"],
      "dependsOrder": "parallel"
    },
    {
      "label": "Client",
      "type": "shell",
      "command": "npm run dev --workspace=client",
      "group": "build",
      "isBackground": true
    },
    {
      "label": "Server",
      "type": "shell",
      "command": "npm run dev --workspace=server",
      "group": "build",
      "isBackground": true
    }
  ]
}

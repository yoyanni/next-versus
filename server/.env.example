# Copy to server/.env for local development.
MONGODB_URI=mongodb://127.0.0.1/localDB

# Optional locally (defaults to 5000). Production sets 3000.
# PORT=5000

# Required when NODE_ENV=production: the exact frontend origin.
# CORS_ORIGIN=http://localhost:3000

# Optional: lets requests with "Authorization: Bearer <token>" edit and delete seed fighters.
# When unset, seed fighters can't be changed through the API. Use a long random value.
# ADMIN_TOKEN=

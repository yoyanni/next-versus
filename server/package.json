{
  "name": "@next-versus/server",
  "version": "1.0.0",
  "description": "Server for next-versus",
  "type": "module",
  "main": "server.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "esbuild src/server.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist/server.js",
    "start": "node dist/server.js",
    "seed": "tsx src/scripts/seed.ts"
  },
  "author": "yoyanni",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "mongoose": "^7.5.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.14",
    "@types/express": "^4.17.17",
    "@types/node": "^20.6.0",
    "esbuild": "^0.25.5",
    "nodemon": "^3.0.1",
    "tsx": "^4.19.4",
    "typescript": "^5.2.2"
  }
}
